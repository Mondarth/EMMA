{
  "name": "mondarth-emma",
  "description": "EMMA - Enhanced Module Manager Application: the Foundry VTT module and the tools around it.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": "Ulenar of Mondarth",
  "contributors": [
    "Ulenar of Mondarth"
  ],
  "packageManager": "pnpm@12.0.0-rc.7",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog",
      "maxHeaderWidth": 72
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "svelte-check": "pnpm -r --if-present run svelte-check",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "test:e2e": "pnpm --filter @mondarth/emma-module run test:e2e",
    "test:e2e:xvfb": "pnpm --filter @mondarth/emma-module run test:e2e:xvfb",
    "e2e:packages": "pnpm --filter @mondarth/emma-module run e2e:packages",
    "e2e:server": "pnpm --filter @mondarth/emma-module run e2e:server",
    "e2e:server:stop": "pnpm --filter @mondarth/emma-module run e2e:server:stop",
    "dev": "pnpm --filter @mondarth/emma-module run dev",
    "dev:setup": "pnpm --filter @mondarth/emma-setup run dev",
    "eslint": "eslint .",
    "prepare": "husky",
    "release:module": "semantic-release --extends ./packages/module/release.config.js",
    "release:extension": "semantic-release --extends ./packages/extension/release.config.js",
    "serve:vtt": "cd .foundryvtt && mkdir -p data/Data/modules/mondarth-emma/dist && touch data/Data/modules/mondarth-emma/module.json && HOST_UID=$(id -u) HOST_GID=$(id -g) docker compose up -d",
    "build:docs": "docker compose run --rm --user \"$(id -u):$(id -g)\" docs make html",
    "serve:docs": "docker run --rm --name docserver -d -p 8080:80 -v \"$(pwd)/docs/_build/html\":/usr/share/nginx/html:ro nginx",
    "devserve:docs": "docker compose run --rm --service-ports --user \"$(id -u):$(id -g)\" docs make livehtml",
    "prettier:format": "prettier --config .prettierrc.json --write \"./packages/*/src/**/*.{ts,js,mjs,json,scss,css}\"",
    "lint-staged": "lint-staged",
    "lint": "eslint packages/",
    "lint:fix": "eslint packages/ --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@mondarth/emma-release": "workspace:*",
    "@playwright/test": "1.64.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.5.4",
    "commitizen": "4.3.2",
    "commitlint-plugin-tense": "^1.0.12",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-svelte": "^3.23.0",
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "semantic-release": "^25.0.9",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "typescript": "npm:@typescript/typescript6",
    "typescript-eslint": "^8.72.0",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "zod": "^4.6.5"
  },
  "browserslist": [
    ">5%",
    "not IE 11"
  ]
}
