{
  // Unit and end-to-end tests are checked together with the module source so they see the Foundry types and local augmentations.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "resolveJsonModule": true,
    // The tests import the build scripts, which import with `.ts` extensions to run under Node.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "tests/**/*"],
  // Playwright's output holds bundled JS (the trace viewer declares globals such as `ui`) that must not join the program.
  "exclude": ["./node_modules/*", "tests/e2e/.data", "tests/e2e/test-results", "tests/e2e/playwright-report"]
}
